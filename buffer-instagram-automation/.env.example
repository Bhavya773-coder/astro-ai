# Buffer API Configuration
# Get your Buffer Access Token / API Key from your Buffer account settings
BUFFER_API_KEY=your_buffer_api_key_here

# Optional: ID of your connected Instagram channel. 
# If left blank, the script will query Buffer and help you select it automatically.
BUFFER_INSTAGRAM_CHANNEL_ID=

# ImgBB API Key for hosting your local ad images publicly (required by Buffer API)
# Create a free account at https://imgbb.com/ to get your API key.
IMGBB_API_KEY=your_imgbb_api_key_here
