{
  "expo": {
    "name": "AstroAi4u",
    "slug": "astro-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astroai4u.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AstroAi4u needs camera access for palm, face, and coffee cup readings.",
        "NSPhotoLibraryUsageDescription": "AstroAi4u needs photo library access to select images for readings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.astroai4u.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "AstroAi4u needs photo library access to select images for readings.",
          "cameraPermission": "AstroAi4u needs camera access for palm, face, and coffee cup readings."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "37e82b0c-cee3-4712-b080-348fccac9efa"
      }
    }
  }
}
